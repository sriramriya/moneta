# Original Sites/Cloudflare target needs no .env. Team mode needs no credentials.
# Optional native Vercel target: provision your OWN isolated test services.
# Copy to ignored .env.local and replace placeholders locally; never commit keys.
DATABASE_URL=<your-test-neon-postgres-url>
NEON_PROJECT_ID=<your-test-neon-project-id>
CLERK_SECRET_KEY=<your-clerk-development-secret-key>
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=<your-clerk-development-publishable-key>
BLOB_READ_WRITE_TOKEN=<your-private-test-blob-token>
# Optional operator maintenance endpoint; use a unique random server-only value.
CRON_SECRET=<your-operator-maintenance-secret>
# No generative AI or exchange-rate provider is configured.
